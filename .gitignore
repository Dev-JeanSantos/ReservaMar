# =============================================================
# ReservaMar — monorepo .gitignore
# apps/api  (Kotlin + Spring Boot + Gradle)
# apps/web  (React + TypeScript + Vite)
# =============================================================

# ---- Backend: Gradle ----
apps/api/.gradle/
apps/api/build/
apps/api/out/
apps/api/*.jar
apps/api/*.war
apps/api/gradle-app.setting
!apps/api/gradle/wrapper/gradle-wrapper.jar

# ---- Backend: configuração local (segredos) ----
apps/api/src/main/resources/application-local.yml
apps/api/src/main/resources/application-local.properties

# ---- Backend: IDE ----
apps/api/.idea/
apps/api/*.iml

# ---- Frontend: Node ----
apps/web/node_modules/
apps/web/dist/
apps/web/.vite/
apps/web/*.tsbuildinfo

# ---- Frontend: tipos gerados (rebuildar com npm run generate:types) ----
apps/web/src/shared/api/types.generated.ts

# ---- Frontend: env local ----
apps/web/.env.local
apps/web/.env.*.local

# ---- IDE (raiz) ----
.idea/
*.iml
.vscode/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Env / segredos (raiz) ----
.env
.env.*
!.env.example
!apps/api/.env.example
!apps/web/.env.example
!infra/compose/.env.example

# ---- Docker ----
docker-compose.override.yml
