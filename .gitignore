# =============================================================
# ReservaMar — monorepo .gitignore
# backend/ (Kotlin + Spring Boot + Gradle)
# frontend/ (React + TypeScript + Vite)
# =============================================================

# ---- Backend: Gradle ----
backend/.gradle/
backend/build/
backend/out/
backend/*.jar
backend/*.war
backend/gradle-app.setting
!backend/gradle/wrapper/gradle-wrapper.jar

# ---- Backend: IntelliJ / IDE ----
backend/.idea/
backend/*.iml
backend/.idea_modules/

# ---- Backend: Spring Boot ----
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-local.properties

# ---- Frontend: Node ----
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/.env
frontend/.env.*
!frontend/.env.example

# ---- Frontend: Build cache ----
frontend/.cache/
frontend/.turbo/

# ---- Env / secrets (raiz) ----
.env
.env.*
!.env.example

# ---- IDE (raiz) ----
.idea/
*.iml
.vscode/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Docker ----
docker-compose.override.yml
