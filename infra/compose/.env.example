# =============================================================
# Variáveis do ambiente local — copie para .env e ajuste
# NUNCA commitar o arquivo .env com valores reais
# =============================================================

# Banco de dados local (Docker Compose)
POSTGRES_DB=reservamar_local
POSTGRES_USER=reservamar
POSTGRES_PASSWORD=localonly

# URL de conexão para o backend (apps/api/application-local.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/reservamar_local
DATABASE_USER=reservamar
DATABASE_PASSWORD=localonly

# Ambiente da aplicação
APP_ENV=local

# Habilitar Swagger UI apenas em local
SWAGGER_ENABLED=true
